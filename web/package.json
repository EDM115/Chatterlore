{
  "name": "@pzp-ai/control-plane",
  "version": "0.11.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node ./scripts/dev.mjs",
    "dev:web": "nuxt dev",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "postinstall": "nuxt prepare",
    "lint": "oxlint --type-aware --deny-warnings .",
    "runtime:check": "node --version",
    "typecheck": "nuxt typecheck",
    "test": "vitest run",
    "build": "nuxt build",
    "start": "node .output/server/index.mjs",
    "smoke:ssr": "node ./scripts/smoke-ssr.mjs",
    "test:e2e": "pnpm build && playwright test",
    "openapi:types": "openapi-typescript ./openapi/control-plane.openapi.json -o ./app/types/openapi.d.ts",
    "openapi:check": "openapi-typescript ./openapi/control-plane.openapi.json -o ./app/types/openapi.d.ts --check",
    "scan:generated": "node ./scripts/scan-generated-assets.mjs ./.output"
  },
  "dependencies": {
    "@nuxt/ui": "~4.11.0",
    "nuxt": "~4.5.2",
    "tailwindcss": "~4.3.3",
    "vue": "~3.5.41",
    "vue-router": "~5.2.0"
  },
  "devDependencies": {
    "@nuxt/test-utils": "~4.1.0",
    "@playwright/test": "~1.62.1",
    "@testing-library/vue": "~8.1.0",
    "@types/node": "^26.3.0",
    "@vue/test-utils": "~2.4.11",
    "happy-dom": "~20.11.6",
    "openapi-typescript": "~7.13.0",
    "oxfmt": "~0.65.0",
    "oxlint": "~1.80.0",
    "oxlint-tsgolint": "~7.0.2001",
    "typescript": "npm:@typescript/typescript6@~6.0.2",
    "vitest": "~4.1.11",
    "vue-tsc": "~3.3.11"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "24.19.0",
      "onFail": "download"
    }
  },
  "engines": {
    "node": "24.19.0"
  },
  "packageManager": "pnpm@11.24.0"
}
