{
  "name": "@pzp-ai/control-plane",
  "version": "0.11.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node ./scripts/dev.mjs",
    "dev:web": "nuxt dev",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "postinstall": "nuxt prepare",
    "lint": "oxlint --type-aware --deny-warnings .",
    "runtime:check": "node --version",
    "typecheck": "nuxt typecheck",
    "test": "vitest run",
    "build": "nuxt build",
    "start": "node .output/server/index.mjs",
    "smoke:ssr": "node ./scripts/smoke-ssr.mjs",
    "test:e2e": "pnpm build && playwright test",
    "openapi:types": "openapi-typescript ./openapi/control-plane.openapi.json -o ./app/types/openapi.d.ts",
    "openapi:check": "openapi-typescript ./openapi/control-plane.openapi.json -o ./app/types/openapi.d.ts --check",
    "scan:generated": "node ./scripts/scan-generated-assets.mjs ./.output"
  },
  "dependencies": {
    "@nuxt/ui": "~4.12.0",
    "nuxt": "~4.6.4",
    "tailwindcss": "~4.3.5",
    "vue": "~3.5.45",
    "vue-router": "~5.4.0"
  },
  "devDependencies": {
    "@nuxt/test-utils": "~4.3.4",
    "@playwright/test": "~1.65.0",
    "@testing-library/vue": "~8.1.0",
    "@types/node": "^26.6.6",
    "@vue/test-utils": "~2.5.1",
    "happy-dom": "~21.0.4",
    "openapi-typescript": "~7.13.0",
    "oxfmt": "~0.77.0",
    "oxlint": "~1.92.0",
    "oxlint-tsgolint": "~7.0.2006",
    "typescript": "npm:@typescript/typescript6@~6.0.2",
    "vitest": "~5.1.0",
    "vue-tsc": "~3.3.14"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "26",
      "onFail": "download"
    }
  },
  "engines": {
    "node": "^26"
  },
  "packageManager": "pnpm@11.28.11"
}
