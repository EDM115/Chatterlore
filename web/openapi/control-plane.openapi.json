        "operationId": "logout_api_control_v1_auth_logout_post",
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ControlPlaneErrorEnvelope"
                }
              }
            },
            "description": "Unauthorized"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ControlPlaneErrorEnvelope"
                }
              }
            },
            "description": "Forbidden"
          }
        },
        "summary": "Logout",
        "x-pzp-capability": "authenticated"
      }
    },
