# Token from @BotFather, leave empty only for offline checks or disconnected UI development
TELEGRAM_BOT_TOKEN=
# Comma-separated numeric Telegram user IDs for recovery owners, replace these example IDs (not usernames or the bot ID)
BOT_ADMINS=123456789,987654321
# Runtime metadata, use the matching `pzp-bot polling` or `pzp-bot webhook` command to select the actual runner
RUNTIME_MODE=polling

# Complete public HTTPS delivery URL such as https://bot.example.com/telegram/webhook, leave empty for polling or disconnected development
WEBHOOK_URL=
# Replace this placeholder with a random Bot API-compatible secret (letters, digits, underscores and hyphens) before webhook startup
WEBHOOK_SECRET=change-me
# Backend bind address, 0.0.0.0 listens on all container/host interfaces and needs a protected ingress
WEBAPP_HOST=0.0.0.0
# Backend HTTP port, distinct from the public HTTPS port
WEBAPP_PORT=8080
# Compose host ports, Caddy uses these for public HTTP and HTTPS TCP/UDP
PZP_HTTP_PORT=80
# Compose HTTPS host port for both TCP and UDP, this does not change Caddy's internal listener
PZP_HTTPS_PORT=443

# Production control plane requires HTTPS, a bot token, OIDC credentials and a valid master-key ring
CONTROL_PLANE_ENABLED=false
# Exact public HTTPS origin such as https://control.example.com, no path/query/fragment (callback appends /auth/telegram/callback)
CONTROL_PLANE_PUBLIC_ORIGIN=
# Positive test identity for `pzp-bot control-plane-dev` and `web/pnpm dev`, include it in BOT_ADMINS for owner features (never production auth)
CONTROL_PLANE_DEV_USER_ID=
# Exact loopback browser origin, localhost and 127.0.0.1 are different origins
CONTROL_PLANE_DEV_ORIGIN=http://localhost:3000
# Loopback API port, change Nuxt's PZP_API_DEV_ORIGIN in the frontend shell to match if needed
CONTROL_PLANE_DEV_API_PORT=8000
# Telegram Login OIDC client credentials from BotFather, separate from TELEGRAM_BOT_TOKEN
TELEGRAM_OIDC_CLIENT_ID=
TELEGRAM_OIDC_CLIENT_SECRET=
# Maximum accepted Telegram authentication age in seconds
CONTROL_PLANE_AUTH_MAX_AGE_SECONDS=300
# Lifetime in seconds of fresh verification bound to an exact sensitive action
CONTROL_PLANE_STEP_UP_MAX_AGE_SECONDS=300
# One-time OIDC login transaction lifetime in seconds
CONTROL_PLANE_OIDC_TRANSACTION_TTL_SECONDS=600
# Session idle expiry in seconds (43200 = 12 hours), at least 60 and no greater than absolute expiry
CONTROL_PLANE_SESSION_IDLE_SECONDS=43200
# Session maximum lifetime in seconds (604800 = 7 days), independent of activity
CONTROL_PLANE_SESSION_ABSOLUTE_SECONDS=604800
# One-line JSON map such as {"primary":"<base64-key>"}, each value must encode 32 independent random bytes (see docs/secrets.md)
CONTROL_PLANE_MASTER_KEYS=
# Non-secret ID present in CONTROL_PLANE_MASTER_KEYS, selects the key used for new credential envelopes
CONTROL_PLANE_ACTIVE_MASTER_KEY_ID=
# Rate-limit window in seconds, the following limits count requests per client in that window
CONTROL_PLANE_RATE_LIMIT_WINDOW_SECONDS=60
# Login-start request limit
CONTROL_PLANE_AUTH_START_RATE_LIMIT=10
# OIDC callback request limit
CONTROL_PLANE_AUTH_CALLBACK_RATE_LIMIT=20
# Signed Mini App exchange request limit
CONTROL_PLANE_MINI_APP_RATE_LIMIT=20
# Sensitive-action fresh-verification request limit
CONTROL_PLANE_STEP_UP_RATE_LIMIT=10
# Explicit provider-test request limit, these actions can incur provider charges
CONTROL_PLANE_PROVIDER_TEST_RATE_LIMIT=5
# Maximum database-managed provider profiles (1 to 256)
CONTROL_PLANE_MAX_MANAGED_PROFILES=32
# Maximum total environment and database credential sources in one managed profile (1 to 10)
CONTROL_PLANE_MAX_CREDENTIALS_PER_PROFILE=10
# Maximum provider-secret input length in characters (1 to 131072)
CONTROL_PLANE_MAX_SECRET_LENGTH=16384
# Best-effort Telegram owner-alert delivery interval in seconds (1 to 3600)
CONTROL_PLANE_ALERT_DELIVERY_INTERVAL_SECONDS=5

# SQLite SQLAlchemy URL, three slashes make data/bot.db relative to the backend working directory (Linux absolute paths use four)
DB_URL=sqlite+aiosqlite:///data/bot.db
# Generated Markdown directory, relative to the backend working directory, SQLite remains authoritative
MEMORY_DIR=data/memory

# fake = deterministic offline output, openai_compatible = remote/local HTTP API, local = optional embedded models
AI_PROVIDER=fake
# Default answer/summary model ID, replace the fake value before using a real provider
CHAT_MODEL=fake-chat
# Default embedding model ID, changing a populated memory's embedding model requires an explicit index migration
EMBEDDING_MODEL=fake-embedding
# Fallback named provider profile, default is assembled from the AI_PROVIDER/model/OPENAI settings below
AI_PROVIDER_PROFILE=default
# Optional named provider profile for answers, empty inherits AI_PROVIDER_PROFILE
AI_CHAT_PROVIDER_PROFILE=
# Optional named provider profile for summaries, empty inherits AI_PROVIDER_PROFILE
AI_SUMMARY_PROVIDER_PROFILE=
# Optional named provider profile for embeddings, empty inherits AI_PROVIDER_PROFILE
AI_EMBEDDING_PROVIDER_PROFILE=
# One-line JSON map keyed by profile name (or list with name), use api_key_env references to exported process variables, see docs/configuration.md
AI_PROVIDER_PROFILES=
# Comma- or ||-separated absolute model root paths, empty defaults to the models directory beside MEMORY_DIR
LOCAL_MODEL_ROOTS=
# Comma- or ||-separated absolute cache root paths, first is the default cache, empty uses models/cache beside MEMORY_DIR
LOCAL_CACHE_ROOTS=
# Comma- or ||-separated exact allowed local-server origins (scheme/host/port, no API path), Docker host addresses need an explicit entry
LOCAL_SERVER_ORIGINS=http://localhost:11434,http://127.0.0.1:11434
# Maximum resident embedded model instances (1 to 32), HTTP model servers are managed outside this process
LOCAL_MAX_LOADED_MODELS=2
# Explicit model-download size cap in bytes (536870912 = 512 MiB), downloading also requires profile and action permission
LOCAL_DOWNLOAD_MAX_BYTES=536870912
# Requested reasoning level (low, medium or high), adapter/model capabilities determine whether it is forwarded
REASONING_LEVEL=medium
# Default remote API key, this built-in setting can load from .env (explicit api_key_env references require process variables)
OPENAI_API_KEY=
# OpenAI-compatible API base URL including its API prefix, use explicit per-profile credentials for other endpoints
OPENAI_BASE_URL=https://api.openai.com/v1

# Fallback learning policy only, explicit global/chat/topic rules override it, false does not prevent local storage of skipped messages
LEARNING_DEFAULT_ENABLED=false
# Mask common secret/personal-data patterns before OpenAI-compatible AI calls, local database text remains unchanged
REDACT_BEFORE_AI=true
# Pending learned-message count that triggers a summary batch (positive integer)
SUMMARY_BATCH_SIZE=25
# Inactivity interval in seconds before summarizing pending messages (900 = 15 minutes)
SUMMARY_IDLE_SECONDS=900
# Number of retrieved memory results per query (positive integer)
RETRIEVAL_TOP_K=6
# Maximum vector candidates considered per scope, durable knowledge takes priority over learned raw messages
RETRIEVAL_CANDIDATE_LIMIT=5000
# Raw-message retention age in days (positive integer), empty disables the environment default retention rule
RAW_MESSAGE_RETENTION_DAYS=
# Durable-knowledge retention age in days (positive integer), independent of raw retention, empty disables the environment default
KNOWLEDGE_RETENTION_DAYS=
# Require summary proposals to be approved before durable knowledge/Markdown publication, manual notes remain direct writes
REVIEW_BEFORE_COMPACT=false
