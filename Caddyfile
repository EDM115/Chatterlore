{$CADDY_SITE_ADDRESS:https://localhost} {
	encode zstd gzip
	header >Strict-Transport-Security "max-age=31536000; includeSubDomains"

	@insecure_forwarded header X-Forwarded-Proto http
	redir @insecure_forwarded https://{host}{uri} permanent

	@backend path /api /api/* /auth /auth/* /telegram/webhook /health
	handle @backend {
		reverse_proxy bot:8080
	}

	handle {
		@assets path /_nuxt/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
		reverse_proxy frontend:3000 {
			header_up -Cookie
			header_up -Authorization
			header_up -X-CSRF-Token
		}
	}
}
